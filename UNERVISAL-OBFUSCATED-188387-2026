local usedNames = {}
local patterns = {"IlIlIl", "lIIlII", "IIllIl"}

local function generateObfuscatedName()
	local partsCount = math.random(1, 3)
	local generatedName = ""
	for i = 1, partsCount do
		generatedName = generatedName .. patterns[math.random(1, #patterns)]
	end
	if math.random() < 0.35 then
		generatedName = generatedName .. tostring(math.random(0, 999))
	end
	if usedNames[generatedName] then
		return generateObfuscatedName()
	end
	usedNames[generatedName] = true
	return generatedName
end

local function normalizeFilename(name)
	if not name or name == "" then
		return "obfuscated_script.lua"
	end
	name = name:gsub("^%s*(.-)%s*$", "%1")
	name = name:gsub("%s+", "_")
	if not name:match("%.%w+$") then
		name = name .. ".lua"
	end
	return name
end

