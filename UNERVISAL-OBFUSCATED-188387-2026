local function createEditor(parent, x, y, w, h)
	local container = Instance.new("Frame", parent)
	container.Position = UDim2.fromOffset(x, y)
	container.Size = UDim2.fromOffset(w, h)
	container.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	container.ClipsDescendants = true
	Instance.new("UICorner", container).CornerRadius = UDim.new(0, 8)

	local lineBg = Instance.new("Frame", container)
	lineBg.Size = UDim2.fromOffset(30, h)
	lineBg.BackgroundColor3 = Color3.fromRGB(18, 18, 18)

	local lines = Instance.new("TextLabel", lineBg)
	lines.Size = UDim2.new(1, -4, 1, 0)
	lines.Position = UDim2.fromOffset(0, 4)
	lines.BackgroundTransparency = 1
	lines.Font = Enum.Font.Code
	lines.TextSize = 11
	lines.TextColor3 = Color3.fromRGB(100, 100, 100)
	lines.TextYAlignment = Enum.TextYAlignment.Top
	lines.TextXAlignment = Enum.TextXAlignment.Right
	lines.Text = "1"

	local scrolling = Instance.new("ScrollingFrame", container)
	scrolling.Position = UDim2.fromOffset(32, 0)
	scrolling.Size = UDim2.new(1, -32, 1, 0)
	scrolling.CanvasSize = UDim2.fromOffset(0, 0)
	scrolling.ScrollBarImageColor3 = Color3.fromRGB(80, 255, 140)
	scrolling.BorderSizePixel = 0
	scrolling.BackgroundTransparency = 1
	scrolling.ScrollingDirection = Enum.ScrollingDirection.XY
	scrolling.ScrollBarThickness = 3

	local box = Instance.new("TextBox", scrolling)
	box.MultiLine = true
	box.ClearTextOnFocus = false
	box.TextWrapped = false
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.TextYAlignment = Enum.TextYAlignment.Top
	box.Font = Enum.Font.Code
	box.TextSize = 11
	box.BackgroundTransparency = 1
	box.TextColor3 = Color3.fromRGB(220, 220, 220)

	scrolling:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		lines.Position = UDim2.fromOffset(0, -scrolling.CanvasPosition.Y + 4)
	end)

	local function update()
		local count = select(2, box.Text:gsub("n", "n")) + 1
		local str = ""
		for i = 1, count do str = str .. i .. "n" end
		lines.Text = str
		local height = math.max(box.TextBounds.Y + 20, container.AbsoluteSize.Y)
		local width = math.max(box.TextBounds.X + 20, scrolling.AbsoluteSize.X)
		box.Size = UDim2.fromOffset(width, height)
		scrolling.CanvasSize = UDim2.fromOffset(width, height)
		lines.Size = UDim2.fromOffset(lineBg.AbsoluteSize.X, height)
	end

	box:GetPropertyChangedSignal("Text"):Connect(update)
	box:GetPropertyChangedSignal("TextBounds"):Connect(update)

	local function autoScroll()
		if not box:IsFocused() then return end
		scrolling.CanvasPosition = Vector2.new(
			math.max(0, box.TextBounds.X - scrolling.AbsoluteWindowSize.X + 20),
			math.max(0, box.TextBounds.Y - scrolling.AbsoluteWindowSize.Y + 20)
		)
	end

	box:GetPropertyChangedSignal("TextBounds"):Connect(autoScroll)
	update()
	return box
end

